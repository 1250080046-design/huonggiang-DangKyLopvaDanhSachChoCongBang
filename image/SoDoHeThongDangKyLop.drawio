    <mxGraphModel dx="1776" dy="1028" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình 4.7. Sequence Diagram - Round Robin\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam sequence {\n ArrowColor #475569\n LifeLineBorderColor #64748B\n LifeLineBackgroundColor #F8FAFC\n ParticipantBorderColor #64748B\n ParticipantBackgroundColor #F8FAFC\n ActorBorderColor #64748B\n ActorBackgroundColor white\n}\n\nactor \&quot;Sinh viên\&quot; as SV\nparticipant \&quot;Frontend\&quot; as FE\nparticipant \&quot;RegistrationController\&quot; as CT\nparticipant \&quot;RegistrationService\&quot; as RS\nparticipant \&quot;RoundRobinScheduler\&quot; as RR\nparticipant \&quot;Repository / JPA\&quot; as DB\n\nSV -&gt; FE : Hủy đăng ký lớp\nFE -&gt; CT : DELETE /api/registrations/{id}\nCT -&gt; RS : cancelRegistration(id)\n\nactivate RS\nRS -&gt; DB : Khóa lớp và sinh viên\nDB --&gt; RS : Dữ liệu cần xử lý\n\nRS -&gt; DB : Cập nhật đăng ký CANCELLED\nRS -&gt; DB : Kiểm tra chỗ trống\nDB --&gt; RS : Sĩ số và sức chứa\n\nopt Lớp còn chỗ và có WAITING\n  RS -&gt; DB : Lấy danh sách chờ và con trỏ\n  DB --&gt; RS : Danh sách WAITING\n\n  loop Còn chỗ và còn ứng viên\n    RS -&gt; RR : next(queue, cursor)\n    RR --&gt; RS : Ứng viên tiếp theo\n    RS -&gt; DB : Khóa sinh viên, kiểm tra điều kiện\n    DB --&gt; RS : Kết quả kiểm tra\n\n    alt Đủ điều kiện\n      RS -&gt; DB : Tạo đăng ký ACTIVE\n      RS -&gt; DB : Đổi WAITING sang PROMOTED\n      RS -&gt; DB : Cập nhật con trỏ và sĩ số\n      RS -&gt; DB : Ghi nhật ký cấp chỗ\n    else Không đủ điều kiện\n      RS -&gt; DB : Đổi WAITING sang INELIGIBLE\n      RS -&gt; DB : Lưu lý do, ghi nhật ký bỏ qua\n    end\n  end\n\n  RS -&gt; DB : Lưu tổng kết lượt xét\nend\n\nRS --&gt; CT : Kết quả hủy đăng ký\ndeactivate RS\nCT --&gt; FE : HTTP response\nFE --&gt; SV : Hiển thị thông báo\n\nnote over RS, DB\n  Các thay đổi bắt buộc thực hiện\n  trong giao dịch nhất quán.\n  Nếu thất bại, rollback.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0BKbGsXcYE_nGH94PA01-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
