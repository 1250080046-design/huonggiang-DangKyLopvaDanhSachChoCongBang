        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình 3.8. Phân rã UC07 - Round Robin\n\nleft to right direction\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam ArrowColor #475569\nskinparam usecase {\n BackgroundColor #F8FAFC\n BorderColor #64748B\n}\n\nrectangle \&quot;Xét chuyển tự động theo Round Robin\&quot; {\n  usecase \&quot;UC07\\nXét chuyển sinh viên\&quot; as Main\n  usecase \&quot;Kiểm tra chỗ trống\&quot; as A\n  usecase \&quot;Đọc con trỏ\\nSinhVienRRGanNhat\&quot; as B\n  usecase \&quot;Chọn ứng viên tiếp theo\&quot; as C\n  usecase \&quot;Kiểm tra điều kiện\\nđăng ký\&quot; as D\n  usecase \&quot;Cấp chỗ trực tiếp\&quot; as E\n  usecase \&quot;Bỏ qua ứng viên\\nkhông hợp lệ\&quot; as F\n  usecase \&quot;Cập nhật con trỏ\&quot; as G\n  usecase \&quot;Ghi nhật ký xét\&quot; as H\n}\n\nMain ..&gt; A : &lt;&lt;include&gt;&gt;\nMain ..&gt; B : &lt;&lt;include&gt;&gt;\nMain ..&gt; C : &lt;&lt;include&gt;&gt;\nMain ..&gt; D : &lt;&lt;include&gt;&gt;\nMain ..&gt; H : &lt;&lt;include&gt;&gt;\n\nE ..&gt; Main : &lt;&lt;extend&gt;&gt;\nF ..&gt; Main : &lt;&lt;extend&gt;&gt;\nE ..&gt; G : &lt;&lt;include&gt;&gt;\n\nnote bottom of Main\n  Tiến trình nghiệp vụ nội bộ;\n  được gọi khi có chỗ trống.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="fQJfiAdU_m4_AuJsudXs-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
