        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình 4.3. Kiến trúc tổng thể hệ thống\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam ArrowColor #475569\nskinparam component {\n BackgroundColor #F8FAFC\n BorderColor #64748B\n FontColor #172033\n}\nskinparam database {\n BackgroundColor #F8FAFC\n BorderColor #64748B\n}\n\ntop to bottom direction\n\nactor \&quot;Sinh viên\&quot; as SV\nactor \&quot;Quản trị viên\&quot; as AD\nactor \&quot;Giảng viên\&quot; as GV\n\npackage \&quot;Frontend - Next.js / React / TypeScript\&quot; {\n  component \&quot;Giao diện người dùng\&quot; as UI\n  component \&quot;API Client\&quot; as Client\n}\n\npackage \&quot;Backend - Java / Spring Boot\&quot; {\n  component \&quot;Spring Security\&quot; as Security\n  component \&quot;REST Controller\&quot; as Controller\n  component \&quot;Service nghiệp vụ\&quot; as Service\n  component \&quot;Round Robin Scheduler\&quot; as RR\n  component \&quot;Spring Data JPA\&quot; as Repo\n}\n\ndatabase \&quot;Microsoft SQL Server\\nHeThongDangKyLop\&quot; as DB\n\nSV --&gt; UI\nAD --&gt; UI\nGV --&gt; UI\n\nUI --&gt; Client\nClient --&gt; Security : HTTP / REST\nSecurity --&gt; Controller\nController --&gt; Service\nService --&gt; RR : Xét danh sách chờ\nService --&gt; Repo\nRR --&gt; Repo\nRepo --&gt; DB : JPA / SQL\n\nnote right of Security\n  JWT trong HttpOnly Cookie\n  CSRF và phân quyền theo vai trò\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="txTi9y3py9c0bjR6oIHl-1">
