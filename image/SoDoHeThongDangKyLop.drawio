        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình 3.3. Use Case tổng quát\n\nleft to right direction\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam actorStyle awesome\nskinparam ArrowColor #475569\nskinparam usecase {\n BackgroundColor #F8FAFC\n BorderColor #64748B\n FontColor #172033\n}\nskinparam rectangle {\n BackgroundColor white\n BorderColor #64748B\n}\n\nactor \&quot;Sinh viên\&quot; as SV\nactor \&quot;Quản trị viên\&quot; as AD\nactor \&quot;Giảng viên\&quot; as GV\n\nrectangle \&quot;HỆ THỐNG ĐĂNG KÝ LỚP HỌC PHẦN\&quot; {\n  package \&quot;Sinh viên\&quot; {\n    usecase \&quot;UC01\\nTra cứu học phần và lớp\&quot; as UC01\n    usecase \&quot;UC02\\nXem đăng ký cá nhân\&quot; as UC02\n    usecase \&quot;UC03\\nĐăng ký lớp\&quot; as UC03\n    usecase \&quot;UC04\\nHủy đăng ký lớp\&quot; as UC04\n    usecase \&quot;UC05\\nTham gia danh sách chờ\&quot; as UC05\n    usecase \&quot;UC06\\nXem vị trí danh sách chờ\&quot; as UC06\n  }\n\n  package \&quot;Xử lý tự động\&quot; {\n    usecase \&quot;UC07\\nXét chuyển theo Round Robin\&quot; as UC07\n  }\n\n  package \&quot;Quản trị\&quot; {\n    usecase \&quot;UC08\\nQuản lý học phần\&quot; as UC08\n    usecase \&quot;UC09\\nQuản lý lớp và sức chứa\&quot; as UC09\n    usecase \&quot;UC10\\nXem nhật ký quyết định\&quot; as UC10\n    usecase \&quot;UC11\\nQuản lý danh sách chờ\&quot; as UC11\n    usecase \&quot;UC12\\nXem và kết xuất thống kê\&quot; as UC12\n  }\n\n  package \&quot;Giảng viên và hỗ trợ\&quot; {\n    usecase \&quot;UC13\\nXem lớp được phân công\&quot; as UC13\n    usecase \&quot;UC14\\nQuản lý tài khoản,\\nkích hoạt và hỗ trợ\&quot; as UC14\n  }\n}\n\nSV -- UC01\nSV -- UC02\nSV -- UC03\nSV -- UC04\nSV -- UC05\nSV -- UC06\nSV -- UC14\n\nAD -- UC08\nAD -- UC09\nAD -- UC10\nAD -- UC11\nAD -- UC12\nAD -- UC14\n\nGV -- UC13\nGV -- UC14\n\nUC04 ..&gt; UC07 : &lt;&lt;include&gt;&gt;\\nKhi phát sinh chỗ\nUC09 ..&gt; UC07 : &lt;&lt;include&gt;&gt;\\nKhi thay đổi sức chứa\n\nnote bottom of UC07\n  Tiến trình nội bộ được kích hoạt\n  khi phát sinh chỗ hợp lệ.\n  Không phải Actor người dùng.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yDrousprCQkpqNIi3n_L-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
