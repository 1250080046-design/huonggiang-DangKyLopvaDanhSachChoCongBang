        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình 3.7. Phân rã UC06 - Xem vị trí chờ\n\nleft to right direction\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam ArrowColor #475569\nskinparam usecase {\n BackgroundColor #F8FAFC\n BorderColor #64748B\n}\n\nactor \&quot;Sinh viên\&quot; as SV\n\nrectangle \&quot;Tra cứu danh sách chờ\&quot; {\n  usecase \&quot;UC06\\nXem vị trí danh sách chờ\&quot; as Main\n  usecase \&quot;Xác minh sinh viên\&quot; as A\n  usecase \&quot;Lấy mục chờ cá nhân\&quot; as B\n  usecase \&quot;Xác định vị trí\\ntrong vòng xét\&quot; as C\n  usecase \&quot;Xem trạng thái chờ\&quot; as D\n  usecase \&quot;Xem lịch sử thay đổi\&quot; as E\n}\n\nSV -- Main\n\nMain ..&gt; A : &lt;&lt;include&gt;&gt;\nMain ..&gt; B : &lt;&lt;include&gt;&gt;\nMain ..&gt; C : &lt;&lt;include&gt;&gt;\nMain ..&gt; D : &lt;&lt;include&gt;&gt;\nE ..&gt; Main : &lt;&lt;extend&gt;&gt;\n\nnote bottom of C\n  Vị trí được tính theo thứ tự\n  ID sinh viên và con trỏ Round Robin,\n  không theo thời gian tham gia.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4bDbpCHcNyydIUbYadX0-1">
