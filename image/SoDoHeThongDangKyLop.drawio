        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình 4.2. Biểu đồ lớp phân tích\n\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam classAttributeIconSize 0\nskinparam ArrowColor #475569\nskinparam class {\n BackgroundColor #F8FAFC\n BorderColor #64748B\n FontColor #172033\n}\n\nclass SinhVien {\n - maSV: Long\n - hoTen: String\n - trangThai: String\n}\n\nclass HocPhan {\n - maHP: Long\n - maHocPhan: String\n - tenHP: String\n - soTinChi: int\n}\n\nclass HocKy {\n - maHK: Long\n - tenHocKy: String\n - namHoc: String\n - ngayBatDau: Date\n - ngayKetThuc: Date\n}\n\nclass LopHoc {\n - maLop: Long\n - tenLop: String\n - sucChua: int\n - soLuongDaDangKy: int\n - trangThai: ClassStatus\n - sinhVienRRGanNhat: Long\n - lichHoc: String\n - phongHoc: String\n + conCho(): boolean\n}\n\nclass DangKy {\n - maDK: Long\n - thoiDiemDangKy: DateTime\n - trangThai: RegistrationStatus\n}\n\nclass MucDanhSachCho {\n - maDSC: Long\n - thoiDiemThamGia: DateTime\n - trangThai: WaitlistStatus\n - lyDoKhongDuDieuKien: String\n - thoiDiemCapNhat: DateTime\n}\n\nclass NhatKyQuyetDinh {\n - maNhatKy: Long\n - thoiDiem: DateTime\n - ketQua: String\n - lyDo: String\n}\n\nclass GiangVien {\n - maGiangVien: Long\n - hoTen: String\n - khoa: String\n}\n\nclass TaiKhoan {\n - maTaiKhoan: Long\n - email: String\n - matKhauHash: String\n - vaiTro: String\n - trangThai: String\n}\n\nTaiKhoan \&quot;1\&quot; -- \&quot;0..1\&quot; SinhVien\nTaiKhoan \&quot;1\&quot; -- \&quot;0..1\&quot; GiangVien\n\nHocPhan \&quot;1\&quot; -- \&quot;0..*\&quot; LopHoc\nHocKy \&quot;1\&quot; -- \&quot;0..*\&quot; LopHoc\nGiangVien \&quot;1\&quot; -- \&quot;0..*\&quot; LopHoc\n\nSinhVien \&quot;1\&quot; -- \&quot;0..*\&quot; DangKy\nLopHoc \&quot;1\&quot; -- \&quot;0..*\&quot; DangKy\n\nSinhVien \&quot;1\&quot; -- \&quot;0..*\&quot; MucDanhSachCho\nLopHoc \&quot;1\&quot; -- \&quot;0..*\&quot; MucDanhSachCho\n\nLopHoc \&quot;1\&quot; -- \&quot;0..*\&quot; NhatKyQuyetDinh\nMucDanhSachCho \&quot;0..1\&quot; -- \&quot;0..*\&quot; NhatKyQuyetDinh\n\nnote right of LopHoc\n  Lịch học được lưu trong\n  thuộc tính của lớp.\n  Không dùng bảng LichHoc riêng.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="E__lQua_b8Sn0kufyiTn-77">
