        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Hình 3.6. Phân rã UC05 - Danh sách chờ\n\nleft to right direction\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam ArrowColor #475569\nskinparam usecase {\n BackgroundColor #F8FAFC\n BorderColor #64748B\n}\n\nactor \&quot;Sinh viên\&quot; as SV\n\nrectangle \&quot;Quản lý yêu cầu chờ cá nhân\&quot; {\n  usecase \&quot;UC05\\nTham gia danh sách chờ\&quot; as Main\n  usecase \&quot;Kiểm tra điều kiện\\ntham gia\&quot; as A\n  usecase \&quot;Kiểm tra mục chờ trùng\&quot; as B\n  usecase \&quot;Tạo mục chờ WAITING\&quot; as C\n  usecase \&quot;Rút khỏi danh sách chờ\&quot; as D\n  usecase \&quot;Xem lý do không đủ\\nđiều kiện\&quot; as E\n  usecase \&quot;Yêu cầu tham gia lại\&quot; as F\n  usecase \&quot;Kiểm tra lại điều kiện\&quot; as G\n}\n\nSV -- Main\nSV -- D\nSV -- E\nSV -- F\n\nMain ..&gt; A : &lt;&lt;include&gt;&gt;\nMain ..&gt; B : &lt;&lt;include&gt;&gt;\nMain ..&gt; C : &lt;&lt;include&gt;&gt;\nF ..&gt; G : &lt;&lt;include&gt;&gt;\n\nnote bottom of F\n  Chỉ áp dụng với mục INELIGIBLE.\n  Không tạo ưu tiên mới.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4dKuKUa6AgB0BC0W5U2t-1">
